/* Inlined, not linked: one page, one visitor, no second view to cache for, and
   a stylesheet link is a render-blocking round trip on rural LTE.

   Motion is CSS scroll-driven — no JavaScript, no observers, nothing on the
   main thread. Every animated element is fully visible in its final state by
   default and the animations only exist inside @supports, so a browser that
   has never heard of animation-timeline shows a complete, static page rather
   than a blank one. */
:root {
  --accent: {{ palette.accent }};
  --accent-ink: {{ palette.accent_ink }};
  --accent-bright: {{ palette.accent_bright }};
  --accent-wash: {{ palette.accent_wash }};
  --accent-edge: {{ palette.accent_edge }};
  --accent-glow: {{ palette.accent_glow }};
  --accent-glow-alt: {{ palette.accent_glow_alt }};
  --accent-fg: {{ palette.accent_fg }};
  --surface: {{ palette.surface }};
  --sunk: {{ palette.surface_sunk }};
  --ink: {{ palette.ink }};
  --muted: {{ palette.ink_muted }};
  --hairline: {{ palette.hairline }};
  --night: {{ palette.night }};
  --night-sunk: {{ palette.night_sunk }};
  --night-ink: {{ palette.night_ink }};
  --night-muted: {{ palette.night_muted }};

  --font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI",
          system-ui, Roboto, "Helvetica Neue", Arial, sans-serif;

  /* Apple's corner radii are large and consistent; the templates differ only
     in how large. */
  --r-card: {% if template_name == 'salon' %}28px{% elif template_name == 'food' %}18px{% else %}20px{% endif %};
  --r-panel: {% if template_name == 'salon' %}34px{% else %}26px{% endif %};
  --r-pill: 980px;

  --gutter: clamp(1.25rem, 5vw, 2.5rem);
  --shell: 1080px;
  --wide: 1400px;
  --section: clamp(4.5rem, 11vw, 9rem);
}

*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

body {
  margin: 0;
  background: var(--surface);
  color: var(--ink);
  font-family: var(--font);
  font-size: 1.0625rem;
  line-height: 1.47;
  letter-spacing: -.012em;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
img { max-width: 100%; height: auto; display: block; }
h1, h2, h3 { margin: 0; text-wrap: balance; }
p { margin: 0 0 1rem; }
p:last-child { margin-bottom: 0; }
a { color: var(--accent-ink); }

.shell { width: 100%; max-width: var(--shell); margin: 0 auto; padding: 0 var(--gutter); }
.shell-wide { width: 100%; max-width: var(--wide); margin: 0 auto; padding: 0 var(--gutter); }
.skip { position: absolute; left: -9999px; top: 0; z-index: 99;
        background: var(--ink); color: #fff; padding: .8rem 1.1rem; border-radius: 0 0 12px 0; }
.skip:focus { left: 0; }
:focus-visible { outline: 3px solid var(--accent-ink); outline-offset: 4px; border-radius: 6px; }

/* ---------- type scale ---------- */
.display {
  font-size: clamp(2.75rem, 8.5vw, 6rem);
  font-weight: 700; line-height: 1.03; letter-spacing: -.035em;
}
.headline {
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 650; line-height: 1.08; letter-spacing: -.028em;
}
.subhead {
  font-size: clamp(1.35rem, 2.6vw, 1.9rem);
  font-weight: 600; line-height: 1.15; letter-spacing: -.022em;
}
.lede {
  font-size: clamp(1.1rem, 1.8vw, 1.3rem);
  line-height: 1.42; color: var(--muted); letter-spacing: -.014em;
}
.eyebrow {
  font-size: .95rem; font-weight: 600; letter-spacing: -.005em;
  color: var(--accent-ink); margin: 0 0 .75rem;
}
.fine { font-size: .78rem; line-height: 1.4; color: var(--muted); letter-spacing: 0; }
.measure { max-width: 34ch; }
.measure-wide { max-width: 52ch; }
.centre { text-align: center; }
.centre .measure, .centre .measure-wide { margin-left: auto; margin-right: auto; }

/* ---------- controls ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: .4rem;
  font: inherit; font-weight: 500; text-decoration: none; white-space: nowrap;
  padding: .82rem 1.45rem; border-radius: var(--r-pill);
  border: 1px solid transparent; transition: transform .2s ease, opacity .2s ease, background .2s ease;
}
.btn-primary { background: var(--accent); color: var(--accent-fg); }
.btn-secondary { background: transparent; color: var(--accent-ink); border-color: var(--accent-edge); }
.btn:hover { transform: scale(1.03); }
.btn:active { transform: scale(.985); }
.btn-sm { padding: .5rem 1.05rem; font-size: .94rem; }
.on-night .btn-primary { background: var(--accent-bright); color: var(--night); }
.on-night .btn-secondary { color: var(--accent-bright); border-color: color-mix(in srgb, var(--night-ink) 30%, transparent); }

/* Apple's other call to action: a coloured label with a chevron. */
.chev {
  display: inline-flex; align-items: center; gap: .25rem;
  text-decoration: none; font-weight: 500; color: var(--accent-ink);
}
.chev::after { content: "\203A"; font-size: 1.25em; line-height: 1; transform: translateY(-.06em); transition: transform .2s ease; }
.chev:hover::after { transform: translate(3px, -.06em); }
.on-night .chev { color: var(--accent-bright); }

.pill {
  display: inline-flex; align-items: center; gap: .45rem; white-space: nowrap;
  font-size: .82rem; font-weight: 500; color: var(--muted);
  border: 1px solid var(--hairline); border-radius: var(--r-pill);
  padding: .32rem .8rem; background: color-mix(in srgb, var(--surface) 70%, transparent);
}
.pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); flex: none; }
.pill.is-open { color: var(--accent-ink); border-color: var(--accent-edge); background: var(--accent-wash); }
.pill.is-open .pill-dot { background: var(--accent); }
.on-night .pill { color: var(--night-muted); border-color: color-mix(in srgb, var(--night-ink) 22%, transparent); background: transparent; }
.on-night .pill.is-open { color: var(--accent-bright); border-color: color-mix(in srgb, var(--accent-bright) 45%, transparent); }
.on-night .pill.is-open .pill-dot { background: var(--accent-bright); }

/* ---------- nav ---------- */
.nav {
  position: sticky; top: 0; z-index: 40;
  background: color-mix(in srgb, var(--surface) 72%, transparent);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  border-bottom: 1px solid color-mix(in srgb, var(--hairline) 60%, transparent);
}
.nav-in { display: flex; align-items: center; gap: 1rem; min-height: 52px; }
.nav-name {
  font-size: 1.05rem; font-weight: 600; letter-spacing: -.02em;
  text-decoration: none; color: inherit; min-width: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.nav-links { display: none; gap: 1.75rem; margin-left: 1.5rem; }
.nav-link { font-size: .88rem; color: var(--muted); text-decoration: none; }
.nav-link:hover { color: var(--ink); }
.nav-right { margin-left: auto; display: flex; align-items: center; gap: .7rem; }
@media (min-width: 860px) { .nav-links { display: flex; } }

/* ---------- sections ---------- */
.section { padding: var(--section) 0; }
.section-tight { padding: calc(var(--section) * .62) 0; }
.section-sunk { background: var(--sunk); }
.on-night { background: var(--night); color: var(--night-ink); }
.on-night .lede, .on-night .fine { color: var(--night-muted); }
.on-night .eyebrow { color: var(--accent-bright); }
.on-night a { color: var(--accent-bright); }

/* ---------- hero ---------- */
.hero { padding: clamp(3rem, 8vw, 6rem) 0 0; }
.hero-copy { padding-bottom: clamp(2.25rem, 5vw, 3.5rem); }
.actions { display: flex; flex-wrap: wrap; gap: .8rem 1.5rem; align-items: center; margin-top: 1.9rem; }
.centre .actions { justify-content: center; }

/* The image slot: owner photography when it exists, generated artwork until
   then. Same box either way, so the layout never shifts when photos arrive. */
/* A deep panel with an aurora in the business's own hue. Dark on purpose: a
   pale gradient reads as an empty placeholder, and this has to hold the screen
   the way a product shot would. Owner photography replaces it entirely. */
.art-panel {
  position: relative; overflow: hidden; isolation: isolate;
  border-radius: var(--r-panel);
  background:
    radial-gradient(105% 85% at 16% 8%, color-mix(in srgb, var(--accent-glow) 46%, transparent) 0%, transparent 56%),
    radial-gradient(90% 80% at 88% 20%, color-mix(in srgb, var(--accent-glow-alt) 38%, transparent) 0%, transparent 60%),
    radial-gradient(150% 120% at 52% 122%, color-mix(in srgb, var(--accent) 62%, transparent) 0%, transparent 74%),
    linear-gradient(158deg, #1a1a1e 0%, #08080a 100%);
  aspect-ratio: 16 / 10;
  --art-line: color-mix(in srgb, #ffffff 62%, transparent);
  --art-fill: #ffffff;
}
.art-panel-tall { aspect-ratio: 4 / 5; }
.art-svg, .art-photo { position: absolute; inset: 0; width: 100%; height: 100%; }
.art-photo { object-fit: cover; }
.art-caption { margin-top: .85rem; }

/* ---------- stats ---------- */
.stats { display: grid; gap: 2.5rem 3rem; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
.stat-value { font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 650; letter-spacing: -.028em; line-height: 1.1; }
.stat-label { color: var(--muted); font-size: .95rem; margin-top: .35rem; }
.on-night .stat-label { color: var(--night-muted); }

/* ---------- sticky stage: the visual pins, the list advances ---------- */
.stage { display: grid; gap: 2.5rem; }
.stage-visual { position: relative; }
@media (min-width: 900px) {
  .stage { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 4.5rem; align-items: start; }
  .stage-visual { position: sticky; top: 6.5rem; }
}

/* ---------- services: one layout per template ---------- */
.cards { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(272px, 1fr)); }
.card {
  border-radius: var(--r-card); background: var(--surface);
  border: 1px solid var(--hairline); padding: 1.9rem 1.7rem;
  transition: transform .3s ease, box-shadow .3s ease;
}
.card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px -22px color-mix(in srgb, var(--ink) 45%, transparent); }
.card-name { font-size: 1.22rem; font-weight: 600; letter-spacing: -.02em; margin: 0 0 .5rem; }
.card-copy { color: var(--muted); margin: 0; }
.on-night .card { background: var(--night-sunk); border-color: color-mix(in srgb, var(--night-ink) 14%, transparent); }
.on-night .card-copy { color: var(--night-muted); }

.menu { display: grid; gap: 0; }
.menu-row { padding: 1.6rem 0; border-bottom: 1px solid var(--hairline); }
.menu-row:last-child { border-bottom: none; }
.menu-name { font-size: 1.3rem; font-weight: 600; letter-spacing: -.022em; margin: 0 0 .35rem; }
.menu-copy { color: var(--muted); margin: 0; }

.stack { display: grid; gap: 2.25rem; }
.stack-row { display: grid; gap: .4rem; }
.stack-name { font-size: 1.28rem; font-weight: 600; letter-spacing: -.022em; }
.stack-copy { color: var(--muted); margin: 0; }

/* ---------- contact ---------- */
.contact-grid { display: grid; gap: 3rem; margin-top: 3rem; }
@media (min-width: 860px) { .contact-grid { grid-template-columns: 1fr 1fr; } }
.phone-xl {
  display: inline-block; text-decoration: none; color: inherit;
  font-size: clamp(2rem, 5.5vw, 3.4rem); font-weight: 650;
  letter-spacing: -.035em; line-height: 1.05;
}
.phone-xl:hover { color: var(--accent-bright); }
.addr { font-style: normal; color: var(--night-muted); margin-top: 1.25rem; line-height: 1.6; }
.hours-table { width: 100%; border-collapse: collapse; font-size: 1rem; }
.hours-table th, .hours-table td { text-align: left; padding: .68rem 0;
  border-bottom: 1px solid color-mix(in srgb, var(--night-ink) 14%, transparent); font-weight: 400; }
.hours-table th { color: var(--night-muted); }
.hours-table td { text-align: right; font-variant-numeric: tabular-nums; }
.hours-table .is-today th, .hours-table .is-today td { color: var(--night-ink); font-weight: 600; }
.hours-caption { font-size: .95rem; font-weight: 600; text-align: left; padding-bottom: .6rem; color: var(--accent-bright); }

.footer { padding: 2.25rem 0 6.5rem; background: var(--sunk); }
.footer-in { display: flex; flex-wrap: wrap; gap: .4rem 1.5rem; }
@media (min-width: 760px) { .footer { padding-bottom: 2.5rem; } }

/* ---------- mobile call bar ---------- */
/* For a trade the call is the conversion, so on a phone it never leaves. */
.callbar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  display: flex; gap: .55rem; padding: .6rem .8rem calc(.6rem + env(safe-area-inset-bottom));
  background: color-mix(in srgb, var(--surface) 80%, transparent);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  border-top: 1px solid color-mix(in srgb, var(--hairline) 70%, transparent);
}
.callbar .btn { flex: 1 1 auto; }
.callbar-call { flex: 2 1 auto; }
@media (min-width: 760px) { .callbar { display: none; } }

@media (max-width: 759px) {
  .nav-right .pill { display: none; }
  .actions .btn { flex: 1 1 100%; }
}

/* ---------- motion ----------
   Scroll-driven, declarative, and entirely optional. Nothing below changes
   what the page says or whether it can be read. */
@media (prefers-reduced-motion: no-preference) {
  @supports (animation-timeline: view()) {
    .rise {
      animation: rise linear both;
      animation-timeline: view();
      animation-range: entry 4% cover 26%;
    }
    .art-panel {
      animation: settle linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 40%;
    }
    .drift {
      animation: drift linear both;
      animation-timeline: view();
      animation-range: cover 0% cover 100%;
    }
    /* The first screen is already in view on load, so it plays on a timer
       instead of a scroll position. */
    .rise-now { animation: rise .75s cubic-bezier(.16, 1, .3, 1) both; }
    .rise-now-2 { animation-delay: .1s; }
    .rise-now-3 { animation-delay: .2s; }
  }
}
@keyframes rise { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }
@keyframes settle { from { opacity: .55; transform: scale(1.06); } to { opacity: 1; transform: none; } }
@keyframes drift { from { transform: translateY(3%); } to { transform: translateY(-3%); } }

@media print {
  .nav, .callbar { position: static; }
  .callbar, .art-panel { display: none; }
  .on-night { background: #fff; color: #000; }
}
