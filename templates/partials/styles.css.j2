/* Inlined, not linked. One page, one visitor, no second view to cache for —
   a separate stylesheet is a render-blocking round trip on rural LTE for
   nothing. Colours come from design.py and are contrast-checked per business. */
:root {
  --accent: {{ palette.accent }};
  --accent-ink: {{ palette.accent_ink }};
  --accent-wash: {{ palette.accent_wash }};
  --accent-edge: {{ palette.accent_edge }};
  --accent-fg: {{ palette.accent_fg }};
  --surface: {{ palette.surface }};
  --sunk: {{ palette.surface_sunk }};
  --ink: {{ palette.ink }};
  --muted: {{ palette.ink_muted }};
  --hairline: {{ palette.hairline }};

  /* The utility face is monospace on purpose: the phone number and the
     structural labels are stencilled, the way they are on a van door. */
  --display: "Avenir Next", "Segoe UI Variable Display", -apple-system,
             BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  --body: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
  --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;

  /* Corner radius is the quietest way the three templates differ: a roofer
     should not have the same silhouette as a nail salon. */
  --radius: {% if template_name == 'salon' %}16px{% elif template_name == 'food' %}2px{% else %}5px{% endif %};
  --gutter: clamp(1.25rem, 5vw, 3rem);
  --shell: 1140px;
}

*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  background: var(--surface);
  color: var(--ink);
  font-family: var(--body);
  font-size: 1.0625rem;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  /* Room for the fixed call bar on phones. */
  padding-bottom: env(safe-area-inset-bottom);
}
img { max-width: 100%; height: auto; }
a { color: var(--accent-ink); }
h1, h2, h3 { font-family: var(--display); margin: 0; text-wrap: balance; }
p { margin: 0 0 1rem; }
p:last-child { margin-bottom: 0; }

.shell { width: 100%; max-width: var(--shell); margin: 0 auto; padding: 0 var(--gutter); }
.skip {
  position: absolute; left: -9999px; top: 0; z-index: 99;
  background: var(--ink); color: #fff; padding: .75rem 1rem;
}
.skip:focus { left: 0; }
:focus-visible { outline: 3px solid var(--accent-ink); outline-offset: 3px; }

/* The stripe: the one piece of pure decoration, and it earns its place by
   carrying the business's colour before any text loads. */
.stripe { height: 5px; background: var(--accent); }

/* ---------- header ---------- */
.masthead {
  position: sticky; top: 0; z-index: 20;
  background: color-mix(in srgb, var(--surface) 88%, transparent);
  backdrop-filter: saturate(1.4) blur(10px);
  border-bottom: 1px solid var(--hairline);
}
.masthead-in {
  display: flex; align-items: center; gap: 1rem;
  min-height: 66px; padding-top: .55rem; padding-bottom: .55rem;
}
.wordmark { display: flex; align-items: center; gap: .7rem; text-decoration: none; color: inherit; min-width: 0; }
.wordmark-badge {
  width: 38px; height: 38px; flex: none;
  display: grid; place-items: center;
  background: var(--accent); color: var(--accent-fg);
  border-radius: var(--radius);
  font-family: var(--mono); font-size: .8rem; font-weight: 700; letter-spacing: .02em;
}
.wordmark-text { display: flex; flex-direction: column; line-height: 1.15; min-width: 0; }
.wordmark-name {
  font-family: var(--display); font-weight: 700; font-size: 1.02rem;
  letter-spacing: -.015em;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.wordmark-kind {
  font-family: var(--mono); font-size: .66rem; text-transform: uppercase;
  letter-spacing: .12em; color: var(--muted);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.masthead-right { margin-left: auto; display: flex; align-items: center; gap: .75rem; }

.pill {
  display: inline-flex; align-items: center; gap: .45rem; white-space: nowrap;
  font-family: var(--mono); font-size: .72rem; letter-spacing: .06em;
  text-transform: uppercase; color: var(--muted);
  border: 1px solid var(--hairline); border-radius: 999px;
  padding: .3rem .7rem; background: var(--surface);
}
.pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); flex: none; }
.pill.is-open { color: var(--accent-ink); border-color: var(--accent-edge); background: var(--accent-wash); }
.pill.is-open .pill-dot { background: var(--accent); }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
  font: inherit; font-weight: 650; text-decoration: none;
  padding: .8rem 1.15rem; border-radius: var(--radius);
  border: 1.5px solid transparent; white-space: nowrap;
}
.btn-primary { background: var(--accent); color: var(--accent-fg); }
.btn-primary:hover { filter: brightness(.93); }
.btn-ghost { border-color: var(--ink); color: var(--ink); background: transparent; }
.btn-ghost:hover { background: var(--ink); color: var(--surface); }
.btn-sm { padding: .55rem .85rem; font-size: .92rem; }
.masthead .btn { font-family: var(--mono); letter-spacing: -.01em; }

/* ---------- section furniture ---------- */
.section { padding: clamp(3.25rem, 8vw, 5.5rem) 0; }
.section-wash { background: var(--accent-wash); }
.section-sunk { background: var(--sunk); }
.eyebrow {
  display: flex; align-items: center; gap: .6rem;
  font-family: var(--mono); font-size: .7rem; font-weight: 600;
  letter-spacing: .16em; text-transform: uppercase; color: var(--muted);
  margin: 0 0 1rem;
}
.eyebrow::before { content: ""; width: 22px; height: 2px; background: var(--accent); flex: none; }
.h2 { font-size: clamp(1.55rem, 3.4vw, 2.3rem); font-weight: 700; letter-spacing: -.02em; line-height: 1.12; }
.lede { color: var(--muted); max-width: 62ch; margin-top: .85rem; }

/* ---------- hero ---------- */
.hero { padding: clamp(2.5rem, 7vw, 4.75rem) 0 clamp(2.5rem, 6vw, 4rem); }
.hero-title {
  font-size: clamp(2.4rem, 7.4vw, 4.6rem);
  font-weight: 800; letter-spacing: -.035em; line-height: .96;
}
.hero-sub { font-size: clamp(1.05rem, 2vw, 1.24rem); color: var(--muted); margin-top: 1.1rem; max-width: 46ch; }
.hero-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.8rem; }

/* The signature: the call plate. Biggest thing on the page, and it dials. */
.plate {
  display: block; text-decoration: none; color: inherit;
  border: 2px solid var(--ink); border-radius: var(--radius);
  background: var(--surface); padding: 1.15rem 1.35rem 1.25rem;
  box-shadow: 6px 6px 0 var(--accent);
  transition: transform .12s ease, box-shadow .12s ease;
}
.plate:hover, .plate:focus-visible { transform: translate(2px, 2px); box-shadow: 3px 3px 0 var(--accent); }
.plate-label {
  font-family: var(--mono); font-size: .68rem; letter-spacing: .2em;
  text-transform: uppercase; color: var(--muted);
  display: flex; justify-content: space-between; gap: 1rem;
}
.plate-number {
  display: block;                       /* a span defaults to inline, which puts
                                           the caption alongside the number */
  font-family: var(--mono); font-weight: 700;
  font-size: clamp(1.45rem, 7vw, 2.15rem);
  letter-spacing: -.03em; margin-top: .45rem; font-variant-numeric: tabular-nums;
  color: var(--ink);
}
.plate-foot {
  display: flex; flex-wrap: wrap; align-items: center; gap: .5rem;
  margin-top: .7rem; font-size: .88rem; color: var(--muted);
}
.plate-foot strong { color: var(--accent-ink); font-weight: 650; }

/* ---------- proof strip ---------- */
.facts { border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); background: var(--surface); }
.facts-in { display: flex; flex-wrap: wrap; gap: 0 2.25rem; padding: 1.1rem 0; }
.fact { display: flex; align-items: baseline; gap: .5rem; padding: .35rem 0; }
.fact-value { font-family: var(--display); font-weight: 700; font-size: 1.06rem; letter-spacing: -.015em; }
.fact-label { font-family: var(--mono); font-size: .68rem; letter-spacing: .13em; text-transform: uppercase; color: var(--muted); }

/* ---------- services ---------- */
.cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(255px, 1fr)); margin-top: 2rem; }
.card { border: 1px solid var(--hairline); border-radius: var(--radius); background: var(--surface); padding: 1.35rem; }
.card-index { font-family: var(--mono); font-size: .7rem; letter-spacing: .14em; color: var(--accent-ink); }
.card-name { font-family: var(--display); font-weight: 700; font-size: 1.1rem; letter-spacing: -.01em; margin: .5rem 0 .4rem; }
.card-copy { color: var(--muted); font-size: .96rem; margin: 0; }

.menu { margin-top: 2rem; border-top: 1px solid var(--hairline); }
.menu-row { display: flex; align-items: baseline; gap: .75rem; padding: 1.05rem 0; border-bottom: 1px solid var(--hairline); }
.menu-name { font-family: var(--display); font-weight: 700; font-size: 1.08rem; letter-spacing: -.01em; flex: none; }
.menu-rule { flex: 1 1 auto; border-bottom: 1px dotted var(--hairline); transform: translateY(-.28em); min-width: 1.5rem; }
.menu-copy { color: var(--muted); font-size: .95rem; text-align: right; max-width: 46ch; }

.stack { margin-top: 2rem; display: grid; gap: 0; }
.stack-row { display: grid; gap: .35rem 2rem; padding: 1.35rem 0; border-bottom: 1px solid var(--accent-edge); }
.stack-name { font-family: var(--display); font-weight: 650; font-size: 1.14rem; letter-spacing: -.01em; }
.stack-copy { color: var(--muted); margin: 0; }

/* ---------- about ---------- */
.split { display: grid; gap: clamp(1.75rem, 5vw, 3.5rem); }
.points { list-style: none; margin: 0; padding: 0; display: grid; gap: .85rem; }
.point { display: flex; gap: .7rem; align-items: flex-start; }
.point-mark { color: var(--accent); font-weight: 800; line-height: 1.5; flex: none; }

/* ---------- contact ---------- */
.contact { background: var(--ink); color: var(--surface); }
.contact .eyebrow { color: color-mix(in srgb, var(--surface) 70%, transparent); }
.contact .eyebrow::before { background: var(--accent); }
.contact .h2 { color: var(--surface); }
.contact a { color: var(--surface); }
.contact-grid { display: grid; gap: clamp(1.75rem, 5vw, 3rem); margin-top: 2rem; }
.contact-plate {
  display: inline-block; text-decoration: none;
  border: 2px solid var(--surface); border-radius: var(--radius);
  padding: 1.05rem 1.3rem; box-shadow: 6px 6px 0 var(--accent);
}
.contact-plate .plate-label { color: color-mix(in srgb, var(--surface) 65%, transparent); }
.contact-plate .plate-number { color: var(--surface); }
.addr { font-style: normal; color: color-mix(in srgb, var(--surface) 78%, transparent); margin-top: 1.1rem; }
.hours-table { width: 100%; border-collapse: collapse; font-size: .95rem; }
.hours-table th, .hours-table td { text-align: left; padding: .48rem 0; border-bottom: 1px solid color-mix(in srgb, var(--surface) 18%, transparent); }
.hours-table th { font-weight: 500; color: color-mix(in srgb, var(--surface) 72%, transparent); }
.hours-table td { text-align: right; font-variant-numeric: tabular-nums; }
.hours-table .is-today th, .hours-table .is-today td { color: var(--surface); font-weight: 650; }

.footer { padding: 2rem 0 6.5rem; font-size: .86rem; color: var(--muted); }
.footer-in { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; align-items: center; }

/* ---------- mobile call bar ---------- */
/* For a trade, the call is the conversion. On a phone it is always on screen. */
.callbar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
  display: flex; gap: .5rem; padding: .55rem .75rem calc(.55rem + env(safe-area-inset-bottom));
  background: color-mix(in srgb, var(--surface) 92%, transparent);
  backdrop-filter: blur(10px); border-top: 1px solid var(--hairline);
}
.callbar .btn { flex: 1 1 auto; }
.callbar-call { flex: 2 1 auto !important; }
@media (min-width: 760px) { .callbar { display: none; } .footer { padding-bottom: 2.5rem; } }

/* ---------- responsive ---------- */
@media (min-width: 760px) {
  .split { grid-template-columns: 1.05fr .95fr; }
  .contact-grid { grid-template-columns: 1fr 1fr; }
  .stack-row { grid-template-columns: 15rem 1fr; }
}
@media (max-width: 759px) {
  /* The header cannot fit a wordmark, a status pill and a phone number at
     390px, and the fixed call bar already owns calling on a phone. Keep the
     name, drop the rest — the status pill lives on the call plate too. */
  .masthead-right { display: none; }
  .menu-row { flex-wrap: wrap; }
  .menu-rule { display: none; }
  .menu-copy { text-align: left; }
  .hero-actions .btn { flex: 1 1 100%; }
  /* The plate below and the fixed bar both dial. A third identical button in
     between is the accessory to take off before leaving the house. */
  .hero-actions .btn-primary { display: none; }
}

/* One reveal on load, and only if the visitor hasn't asked for stillness. */
@media (prefers-reduced-motion: no-preference) {
  .reveal { animation: rise .5s cubic-bezier(.2, .7, .3, 1) both; }
  .reveal-2 { animation-delay: .07s; }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
}
@media print { .masthead, .callbar { position: static; } .callbar { display: none; } }
